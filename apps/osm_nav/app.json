{
  "id": "osm_nav",
  "title": "Navigation",
  "description": "Offline OpenStreetMap navigation for Georgia (Georgian and English) in place of the BMW map: GPU map at 60 fps, turn-by-turn guidance, speed limits, and the console's NAV button",
  "version": "1.0.0",
  "vendor": "custom",
  "loggingId": "OANV",
  "iconGlyph": "nav",
  "mguInternet": false,
  "replacesStockNav": true,
  "startWidget": {
    "name": "Navigation",
    "layout": "LT_Table_OnlineApps_DriveRecorderWidget",
    "image": "BackgroundImage1",
    "cells": {
      "HeadlineText": [
        "Navigation",
        "Text"
      ]
    }
  },
  "mguHmi": [
    "ID7"
  ],
  "maxDiskUsage": 268435456,
  "memoryKB": 196608,
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    }
  },
  "screens": [
