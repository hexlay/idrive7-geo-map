  "config": {
    "comment": "positioning: the car's own position. Each entry: { iface, instance, field, lat, lon, heading, speed (dotted paths into the field's value), valid (a flag that must be true), fix (an enum that must not be NO_FIX / FIX_1D), scale: { lat, lon, heading, speed } (multipliers to degrees / km/h) }; the interface is in \"signals\" too, with \"_optional\". The two below are the navigation's Positioning service, as nhocleopro/hud-widgets read it on a BMW X3 G01 LCI (L18_22w10.5, 2026-11-12: a valid FIX_3D about 9 m from a phone's GPS, parked); not yet seen on this app's target cars. Between fixes, and with none: speed and turn rate along the roads (dead reckoning).",
    "positioning": [
      {
        "iface": "de.bmw.infotainment.navigation.positioning.Positioning",
        "instance": "Main_Instance",
        "field": "rawPositionData",
        "lat": "position.latitude",
        "lon": "position.longitude",
        "heading": "heading",
        "fix": "fixType"
      },
      {
        "iface": "de.bmw.infotainment.navigation.positioning.Positioning",
        "instance": "Main_Instance",
        "field": "currentLocation",
        "lat": "latitude",
        "lon": "longitude",
        "valid": "coordinatesValid"
      }
    ],
    "reverseGuardComment": "reverseGuard: while the car's gear selector is in reverse (VehicleInformation statusGearboxDrive / DataPowerTrain2, read only) nothing opens Navigation, and a shown Navigation gives its picture and the controller back to the HMI, which shows its camera as without the app. It does not depend on the camera's surface ids (mgu-render.conf yield_surfaces), which are still asked as well. false: the gear is not asked.",
    "reverseGuard": true,
    "navButtonComment": "navButton: what the console's NAV button sends, so pressing it opens this app on top of the stock screen. The HMI always gets the button too (nothing is blocked): with this app not running, NAV works as stock. Two sources: the controller gate's read-only button feed (mgu-inputgate.so built from kit/renderd/inputgate, and /var/opt/mgu-inputgate/buttons, which the installer creates), or a SOME/IP field: iface + field from deploy/car/nav-recon.sh (add it to signals with _optional). match: byte pattern in hex, xx for a byte that changes (a counter), e.g. \"xx 01 a4 xx\"; the Route page can learn it (press NAV three times). Empty: learn on the car.",
    "navButton": {
      "match": "",
      "iface": null,
      "instance": "1",
      "field": null
    },
    "stockNavComment": "stockNav: the stock BMW map, so Navigation opens in its place however it is opened (the left menu bar NAV icon, the Navigation tile, voice). Nothing is blocked or hidden: Navigation opens over it, and BACK from Navigation leaves you on the stock map without opening Navigation again. Sources: mgu-render surface lines (nav_watch = 1 in mgu-render.conf; surfaceId and / or proc of the stock map surface, at least minWidth x minHeight; the Route page learns it: tap Learn BMW map and open the BMW map from the side menu), or a SOME/IP field (iface, instance, field; match: navkey pattern of the value while the stock map is in front) found with deploy/car/nav-recon.sh (LABEL=base / LABEL=stocknav). Empty: learn on the car.",
    "stockNav": {
      "surfaceId": null,
      "proc": "",
      "minWidth": 800,
      "minHeight": 400,
      "iface": null,
      "instance": "1",
      "field": null,
      "match": ""
    }
  }
